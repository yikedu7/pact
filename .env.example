# TESTNET ONLY. Never put a key that holds real funds here.
# Prefer a Foundry keystore (`cast wallet import deployer --interactive`) and `--account deployer`
# over PRIVATE_KEY.
PRIVATE_KEY=

# Optional: reuse existing contracts instead of deploying new ones.
PAYMENT_TOKEN=
IDENTITY_REGISTRY=
REPUTATION_REGISTRY=

# Optional: when MockUSDC is deployed, mint this many base units (6 decimals) to MOCK_USDC_MINT_TO
# (defaults to the deployer). 1000000000 = 1,000 mUSDC.
MOCK_USDC_MINT=
MOCK_USDC_MINT_TO=

# Immutable fallback when an order passes verifier = address(0). Defaults to the deployer.
# Demo orders pass the buyer address instead. The Monad deployment value
# 0x7E70cCAB3c6862005988E1B2e31D76C35EFaC8A8 is not used for new orders.
# Privy credentials never go here.
DEFAULT_VERIFIER=

# Default true: write deployments/<chainId>.json for the off-chain agents.
WRITE_DEPLOYMENT=true

# script/Demo.s.sol is an optional local replay (not Path A). Two keys. Verifier is the buyer.
# Required off anvil; each needs gas. The buyer also needs the payment token unless it is MockUSDC.
BUYER_PRIVATE_KEY=
EXPERT_PRIVATE_KEY=
# pass | fail | timeout, and user | approve_for_me
SCENARIO=pass
APPROVAL_MODE=user
# Reuse agents registered by an earlier demo run instead of registering new ones.
EXPERT_AGENT_ID=
BUYER_AGENT_ID=

# Verification (Base Sepolia via Etherscan V2; Monad testnet uses Sourcify and needs no key).
ETHERSCAN_API_KEY=

# --- TypeScript agents (see agents/.env.example and docs/PRIVY_NOTES.md) ---
# Path B (public / self-host): set BUYER_PRIVATE_KEY and EXPERT_PRIVATE_KEY. Leave Privy unset.
# Path A (shared Guild app): PRIVY_APP_ID / PRIVY_APP_SECRET, plus only that bot's wallet id.
# Do not set PRIVY_WALLET_VERIFIER_* for the demo. Do not put the app secret in a public skill.
# RPC_URL=                    # or MONAD_TESTNET_RPC / BASE_SEPOLIA_RPC
# PRIVY_CAIP2=eip155:10143     # path A only
# GUILD_TX_AMOUNT_CAP=100000000
# GUILD_DAILY_AMOUNT_CAP=500000000
# SCENARIO=pass                # pass | fail | timeout
# APPROVAL_MODE=user           # optional logo demo only; role commands use the frozen task
