# TESTNET ONLY. Never put a key that holds real funds here.
# Prefer a Foundry keystore (`cast wallet import deployer --interactive`) and `--account deployer`
# over PRIVATE_KEY.
PRIVATE_KEY=

# Optional: reuse existing contracts instead of deploying new ones.
PAYMENT_TOKEN=
IDENTITY_REGISTRY=
REPUTATION_REGISTRY=

# Optional: when MockUSDC is deployed, mint this many base units (6 decimals) to MOCK_USDC_MINT_TO
# (defaults to the deployer). 1000000000 = 1,000 mUSDC.
MOCK_USDC_MINT=
MOCK_USDC_MINT_TO=

# Default true: write deployments/<chainId>.json for the off-chain agents.
WRITE_DEPLOYMENT=true

# Verification (Base Sepolia via Etherscan V2; Monad testnet uses Sourcify and needs no key).
ETHERSCAN_API_KEY=
