# TESTNET ONLY. Never put a key that holds real funds here.
# Prefer a Foundry keystore (`cast wallet import deployer --interactive`) and `--account deployer`
# over PRIVATE_KEY.
PRIVATE_KEY=

# Optional: reuse existing contracts instead of deploying new ones.
PAYMENT_TOKEN=
IDENTITY_REGISTRY=
REPUTATION_REGISTRY=

# Optional: when MockUSDC is deployed, mint this many base units (6 decimals) to MOCK_USDC_MINT_TO
# (defaults to the deployer). 1000000000 = 1,000 mUSDC.
MOCK_USDC_MINT=
MOCK_USDC_MINT_TO=

# Protocol-default verifier bot address, used when an order does not name its own verifier.
# Immutable once deployed (rotating it means redeploying TaskEscrow). Defaults to the deployer.
# Use the Privy verifier server wallet's address (docs/PRIVY_NOTES.md); Privy credentials never go here.
DEFAULT_VERIFIER=

# Default true: write deployments/<chainId>.json for the off-chain agents.
WRITE_DEPLOYMENT=true

# script/Demo.s.sol parties (required off anvil; each needs gas, the buyer also needs the payment token
# unless it is MockUSDC, which the demo mints). Three distinct testnet-only keys.
BUYER_PRIVATE_KEY=
EXPERT_PRIVATE_KEY=
VERIFIER_PRIVATE_KEY=
# pass | fail | timeout, and user | approve_for_me
SCENARIO=pass
APPROVAL_MODE=user
# Reuse agents registered by an earlier demo run instead of registering new ones.
EXPERT_AGENT_ID=
BUYER_AGENT_ID=
VERIFIER_AGENT_ID=

# Verification (Base Sepolia via Etherscan V2; Monad testnet uses Sourcify and needs no key).
ETHERSCAN_API_KEY=

# --- TypeScript agents (see agents/.env.example and docs/PRIVY_NOTES.md) ---
# Shared Guild Privy app. Leave wallet ids empty to auto-create on first bootstrap.
# RPC_URL=                    # or MONAD_TESTNET_RPC / BASE_SEPOLIA_RPC
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# PRIVY_WALLET_BUYER_ID=
# PRIVY_WALLET_EXPERT_ID=
# PRIVY_WALLET_VERIFIER_ID=
# PRIVY_WALLET_BUYER_ADDRESS=
# PRIVY_WALLET_EXPERT_ADDRESS=
# PRIVY_WALLET_VERIFIER_ADDRESS=
# PRIVY_CAIP2=eip155:10143
# GUILD_TX_AMOUNT_CAP=100000000
# GUILD_DAILY_AMOUNT_CAP=500000000
# SCENARIO=pass                # pass | fail | timeout
# APPROVAL_MODE=user           # logo demo only; after-accept uses the frozen task
