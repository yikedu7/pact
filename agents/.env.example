# Copy to agents/.env or repo-root .env (cli loads both).

# RPC (pick one chain)
RPC_URL=http://127.0.0.1:8545
# MONAD_TESTNET_RPC=https://…
# BASE_SEPOLIA_RPC=https://…

# Optional explicit chain id (otherwise inferred from RPC)
# CHAIN_ID=31337

# CAIP-2 for Privy eth_sendTransaction (required when using Privy)
# PRIVY_CAIP2=eip155:31337
# PRIVY_CAIP2=eip155:10143
# PRIVY_CAIP2=eip155:84532

# Path A — shared Guild Privy app. Each bot sets only its own wallet id.
# Buyer bot: PRIVY_WALLET_BUYER_*. Expert bot: PRIVY_WALLET_EXPERT_*.
# Public skills must leave the app secret empty. Never commit the values.
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# PRIVY_WALLET_BUYER_ID=
# PRIVY_WALLET_BUYER_ADDRESS=
# PRIVY_WALLET_EXPERT_ID=
# PRIVY_WALLET_EXPERT_ADDRESS=
# Archived, not the demo path. Do not set these on buyer or expert bots.
# New orders set verifier to the buyer. 0x7E70cCAB3c6862005988E1B2e31D76C35EFaC8A8 is unused.
# # PRIVY_WALLET_VERIFIER_ID=
# # PRIVY_WALLET_VERIFIER_ADDRESS=

# Policy caps in USDC base units (6 decimals). Defaults: 100 USDC per order, 500 USDC per UTC day.
# GUILD_TX_AMOUNT_CAP=100000000
# GUILD_DAILY_AMOUNT_CAP=500000000

# Path B — public skill / self-host (LocalEoa). Generate with `cast wallet new`.
# On chain 31337 the buyer and expert keys may be omitted (anvil defaults).
BUYER_PRIVATE_KEY=
EXPERT_PRIVATE_KEY=
# Optional local-dev only (GUILD_OPTIONAL_THIRD_VERIFIER=1). Not the demo path.
# VERIFIER_PRIVATE_KEY=

# Demo knobs (mirror script/Demo.s.sol)
SCENARIO=pass
APPROVAL_MODE=user
EXPERT_AGENT_ID=0
BUYER_AGENT_ID=0
# Optional. The demo path does not register a verifier agent.
# VERIFIER_AGENT_ID=0

# Path to deployments/<chainId>.json (default: repo root deployments/)
# DEPLOYMENTS_DIR=../deployments
